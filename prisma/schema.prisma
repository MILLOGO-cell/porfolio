generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  password              String
  profileImage          String?   @map("profile_image")
  resetToken            String?   @map("reset_token")
  resetTokenExpiry      DateTime? @map("reset_token_expiry")
  
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  twoFactorMethod       String?   @map("two_factor_method")
  totpSecret            String?   @map("totp_secret")
  emailCodeSecret       String?   @map("email_code_secret")
  emailCodeExpiry       DateTime? @map("email_code_expiry")
  
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  
  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  /// Identifiant d'URL lisible : /projets/mobile-banking-amplitude
  slug        String   @unique
  title       String
  /// Accroche d'une ou deux phrases : carte de liste et meta description.
  summary     String?
  /// Présentation générale, conservée depuis l'ancien modèle.
  description String?

  // --- Étude de cas : ce qui distingue une fiche projet d'une vignette ---
  /// Le besoin métier et les contraintes de départ.
  context     String?
  /// Le périmètre réellement tenu : conception, développement, intégration…
  role        String?
  /// Décisions techniques structurantes et difficultés rencontrées.
  challenges  String?
  /// Ce qui a été livré et ce que cela a changé.
  outcome     String?

  /// Client ou secteur (« banque de détail ») si le nom est confidentiel.
  client      String?
  /// Période libre : « 2024 — 2025 ».
  period      String?
  /// Technologies mises en œuvre — distinct de `tags`, qui sert au filtrage.
  stack       String[]

  url         String?
  repoUrl     String?  @map("repo_url")
  imageUrl    String?  @map("image_url")
  tags        String[]
  featured    Boolean  @default(false)
  /// Ordre d'affichage maîtrisé ; à défaut, tri par date de création.
  position    Int      @default(0)
  /// Permet de préparer une fiche sans la publier.
  published   Boolean  @default(true)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([published, featured])
  @@map("projects")
}

model Visitor {
  id        String   @id @default(cuid())
  lastIp    String?  @map("last_ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  visits    Visit[]

  @@map("visitors")
}

model Visit {
  id        String   @id @default(cuid())
  visitorId String   @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  path      String
  referer   String?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("visits")
}