# Modèle de configuration. Copier en .env.local et renseigner les valeurs.
# Le vrai fichier n'est jamais versionné.

# Base PostgreSQL (Neon : chaîne "pooled" pour DATABASE_URL, "direct" pour DIRECT_URL)
DATABASE_URL=
DIRECT_URL=

# Authentification (next-auth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Compte administrateur créé au déploiement
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Envoi des messages du formulaire de contact
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Stockage des images (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Facultatif : adresse publique du site (liens, sitemap, image d'aperçu)
NEXT_PUBLIC_SITE_URL=
